# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY – never prefix with NEXT_PUBLIC_. Used for placing orders & storing receipts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Random 32+ char string. Signs customer order-tracking links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_TOKEN_SECRET=change-me

# --- Store settings ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Lumo Store
NEXT_PUBLIC_CURRENCY=MVR
DELIVERY_FEE=0

# Bank transfer details shown on the payment page
NEXT_PUBLIC_BANK_NAME=Bank of Maldives
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Your Business Name
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=7730000000000
NEXT_PUBLIC_CONTACT_PHONE=+960 7000000
